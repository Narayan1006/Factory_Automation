            "properties": [
              { "id": "displayName", "value": "Risk Score" },
              { "id": "unit", "value": "percentunit" }
            ]
          }
        ]
      },
      "targets": [
        {
          "query": "from(bucket: \"factory_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"part_risk\" and r._field == \"cumulative_risk\" and r._value > 0.5)\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)\n  |> keep(columns: [\"_time\", \"part_id\", \"current_station\", \"risk_level\", \"_value\"])\n  |> rename(columns: {_value: \"risk_score\", current_station: \"station\"})",
          "refId": "A"
