      "title": "Cumulative Part Risk Trends over Time",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB_Line3" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 0.3 },
              { "color": "red", "value": 0.7 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Peak Risk" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mean Risk" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "query": "from(bucket: \"factory_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"part_risk\" and r._field == \"cumulative_risk\")\n  |> group()\n  |> aggregateWindow(every: 10s, fn: mean, createEmpty: false)\n  |> set(key: \"_field\", value: \"Mean Risk\")\n  |> yield(name: \"mean\")",
          "refId": "A"
        },
        {
          "query": "from(bucket: \"factory_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"part_risk\" and r._field == \"cumulative_risk\")\n  |> group()\n  |> aggregateWindow(every: 10s, fn: max, createEmpty: false)\n  |> set(key: \"_field\", value: \"Peak Risk\")\n  |> yield(name: \"peak\")",
          "refId": "B"
        }
      ]
    },
