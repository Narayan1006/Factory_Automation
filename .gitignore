# Virtual environment
.venv/
env/
venv/

# Raw dataset & large archives (SAFETY FIRST: NEVER COMMITTED)
data/
*.zip
*.tar.gz
*.parquet.tmp

# Large parquet tables (over 10MB or regenerable)
*.parquet
!artifacts/replay_data/
artifacts/replay_data/*.parquet
artifacts/ai_data/*.parquet
exploration/output/*.parquet
data_prep/output/*.parquet

# Runtime logs
artifacts/logs/*
!artifacts/logs/.gitkeep

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Environment & credentials
.env
infra/.env
*.token

# InfluxDB and Grafana local docker volumes
influxdb_data/
grafana_data/
mosquitto_data/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.baseline/
