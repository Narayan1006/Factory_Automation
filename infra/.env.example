# Environment Configuration for Bosch Line 3 Digital Twin

# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=admin_password_123
DOCKER_INFLUXDB_INIT_ORG=bosch_twin
DOCKER_INFLUXDB_INIT_BUCKET=factory_telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=bosch-digital-twin-super-secret-auth-token-12345
DOCKER_INFLUXDB_INIT_RETENTION=30d

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password_123
GF_USERS_ALLOW_SIGN_UP=false

# Ports
MQTT_PORT=1883
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
